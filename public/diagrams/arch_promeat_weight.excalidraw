   "boundElements": null,
   "link": null,
   "locked": false,
   "type": "text",
   "text": "a 35-day Ross and a 42-day Ross with the same\nsilhouette are not the same animal. age and line\ngo into the head as features \u2014 they are not a\ncaption on the video.",
   "originalText": "a 35-day Ross and a 42-day Ross with the same\nsilhouette are not the same animal. age and line\ngo into the head as features \u2014 they are not a\ncaption on the video.",
