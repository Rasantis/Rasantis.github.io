   "locked": false,
   "type": "text",
   "text": "{\n  \"lote\":        38,\n  \"linhagem\":    \"ROSS\",\n  \"idade_dias\":  35,\n  \"bird_id\":     124,\n  \"peso_kg\":     3.18,\n  \"conf\":        0.91\n}",
