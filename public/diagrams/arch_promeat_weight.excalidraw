   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "type": "text",
   "text": "the mask is the hard part.\nthe kilo is the easy part.\nthe birds are one colour, they\ndeform, and they lean on each other.",
   "originalText": "the mask is the hard part.\nthe kilo is the easy part.\nthe birds are one colour, they\ndeform, and they lean on each other.",
