   "versionNonce": 915108456,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "type": "text",
   "text": "nobody can put 25,000 birds on a scale.\nthe ground truth is a few hundred pairs from\nthe scale in the house \u2014 and every other choice\nin this system exists to make those few hundred carry.",
   "originalText": "nobody can put 25,000 birds on a scale.\nthe ground truth is a few hundred pairs from\nthe scale in the house \u2014 and every other choice\nin this system exists to make those few hundred carry.",
   "fontSize": 13,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
  {
   "id": "n18",
   "x": 800,
   "y": 1029,
   "width": 420,
   "height": 62.5,
   "angle": -0.006,
   "strokeColor": "#9aa5b4",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "seed": 405411846,
   "version": 1,
   "versionNonce": 1802730921,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "type": "text",
   "text": "split by lote, never at random.\ntwo frames of the same bird on both\nsides of the split and the 98.5% is a\nnumber about yourself, not about the flock.",
   "originalText": "split by lote, never at random.\ntwo frames of the same bird on both\nsides of the split and the 98.5% is a\nnumber about yourself, not about the flock.",
   "fontSize": 12.5,
