   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "type": "text",
   "text": "crop  = mask * frame        # background zeroed\nfeat  = backbone(crop)\nctx   = [idade_dias, linhagem_onehot]\nkg    = head(concat(feat, ctx))\n\nloss  = MAE(kg, peso_balanca)",
   "originalText": "crop  = mask * frame        # background zeroed\nfeat  = backbone(crop)\nctx   = [idade_dias, linhagem_onehot]\nkg    = head(concat(feat, ctx))\n\nloss  = MAE(kg, peso_balanca)",
   "fontSize": 11.5,
