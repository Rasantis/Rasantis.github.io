   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "type": "text",
   "text": "detection is not an event.\nan event needs a zone, dwell time and a\nconcealment sequence \u2014 otherwise you page\na human 400 times a night.",
   "originalText": "detection is not an event.\nan event needs a zone, dwell time and a\nconcealment sequence \u2014 otherwise you page\na human 400 times a night.",
