   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "type": "text",
   "text": "rtspsrc location=... latency=200\n  ! rtph264depay ! h264parse\n  ! nvv4l2decoder            # NVDEC, not CPU\n  ! nvvidconv ! video/x-raw(memory:NVMM)\n  ! appsink   -> amqp publish -> TensorRT",
   "originalText": "rtspsrc location=... latency=200\n  ! rtph264depay ! h264parse\n  ! nvv4l2decoder            # NVDEC, not CPU\n  ! nvvidconv ! video/x-raw(memory:NVMM)\n  ! appsink   -> amqp publish -> TensorRT",
   "fontSize": 11.5,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
  {
   "id": "n10",
   "x": 66,
