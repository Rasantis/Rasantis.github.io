   "boundElements": null,
   "link": null,
   "locked": false,
   "type": "text",
   "text": "edge pipeline \u2014 decode never touches the CPU",
   "originalText": "edge pipeline \u2014 decode never touches the CPU",
   "fontSize": 11,
