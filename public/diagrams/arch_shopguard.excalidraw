   "boundElements": null,
   "link": null,
   "locked": false,
   "type": "text",
   "text": "rtspsrc location=... latency=200\n  ! rtph264depay ! h264parse\n  ! nvv4l2decoder            # NVDEC, not CPU\n  ! nvvidconv ! video/x-raw(memory:NVMM)\n  ! appsink                  -> TensorRT engine",
   "originalText": "rtspsrc location=... latency=200\n  ! rtph264depay ! h264parse\n  ! nvv4l2decoder            # NVDEC, not CPU\n  ! nvvidconv ! video/x-raw(memory:NVMM)\n  ! appsink                  -> TensorRT engine",
   "fontSize": 11.5,
