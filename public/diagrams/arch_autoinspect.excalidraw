   "link": null,
   "locked": false,
   "type": "text",
   "text": "for d in defect_masks:\n    p = argmax(panel_masks, key=lambda p: iou(d, p))\n    if iou(d, p) < MIN_OVERLAP:\n        abstain(d)        # cannot place it -> not a line item\n    else:\n        finding(defect=d.cls, panel=p.cls, conf=d.conf)",
   "originalText": "for d in defect_masks:\n    p = argmax(panel_masks, key=lambda p: iou(d, p))\n    if iou(d, p) < MIN_OVERLAP:\n        abstain(d)        # cannot place it -> not a line item\n    else:\n        finding(defect=d.cls, panel=p.cls, conf=d.conf)",
