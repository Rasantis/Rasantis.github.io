   "boundElements": null,
   "link": null,
   "locked": false,
   "type": "text",
   "text": "panels    mask mAP50  0.65     23 classes    3,156 images\ndefects   mask mAP50  0.12      8 classes      655 images\n\n          reported per class \u2014 including the two of the\n          eight that did not learn at all.",
   "originalText": "panels    mask mAP50  0.65     23 classes    3,156 images\ndefects   mask mAP50  0.12      8 classes      655 images\n\n          reported per class \u2014 including the two of the\n          eight that did not learn at all.",
   "fontSize": 11.5,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
