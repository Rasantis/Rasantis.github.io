   "version": 1,
   "versionNonce": 1827561537,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "type": "text",
   "text": "the honest way to read this board:\nthe panel model is good, the defect\nmodel is not, and the product works\nanyway because the weak one is never\nasked a question it cannot answer.",
   "originalText": "the honest way to read this board:\nthe panel model is good, the defect\nmodel is not, and the product works\nanyway because the weak one is never\nasked a question it cannot answer.",
